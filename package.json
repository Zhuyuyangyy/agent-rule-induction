{
  "name": "p0-vs",
  "version": "0.1.0",
  "type": "module",
  "description": "Active Theory Discovery: P0 rule-induction benchmark with active query, version-space falsification, and SHA256-audited baselines.",
  "scripts": {
    "gen-tasks": "tsx src/taskGenerator.ts --n 100 --seed 42 --output results/tasks_seed42.json",
    "run-passive": "tsx src/runPassive.ts --tasks results/tasks_seed42.json --experiment-id p0_benchmark --condition llm_passive --overwrite",
    "run-scaffold": "tsx src/runScaffold.ts --tasks results/tasks_seed42.json --experiment-id p0_benchmark --condition llm_scaffold --overwrite",
    "run-active": "tsx src/runActive.ts --tasks results/tasks_seed42.json --experiment-id p0_benchmark --condition llm_active --overwrite",
    "run-active-random": "tsx src/analyzeResults.ts --dir results --tasks results/tasks_seed42.json",
    "analyze": "tsx src/analyzeResults.ts --dir results --tasks results/tasks_seed42.json",
    "benchmark": "tsx src/runBenchmark.ts --n 100 --seed 42 --result-dir results",
    "benchmark-no-llm": "tsx src/runBenchmark.ts --n 100 --seed 42 --result-dir results --skip-llm",
    "multi-seed": "tsx src/runMultiSeed.ts --seeds 1,2,3,4,5 --n 100 --result-dir results/p0_multi_seed",
    "multi-seed-no-llm": "tsx src/runMultiSeed.ts --seeds 1,2,3,4,5 --n 100 --result-dir results/p0_multi_seed --skip-llm",
    "p1:benchmark": "tsx src/p1/benchmark.ts --n 60 --seed 42 --skip-llm",
    "p1:test": "tsx src/p1/test.ts",
    "p1-benchmark": "tsx src/p1/p1Benchmark.ts --n 60 --seed 42 --noise 0 --output results/p1_report.json",
    "p1-benchmark-noisy": "tsx src/p1/p1Benchmark.ts --n 60 --seed 42 --noise 0.05 --output results/p1_report_noisy.json",
    "test": "tsx src/test.ts && tsx src/testApiSafety.ts && tsx src/testParseResponse.ts && tsx src/testRunnerMock.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
