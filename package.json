{
  "name": "active-theory-discovery",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx src/test.ts",
    "p1:benchmark": "tsx src/p1/p1Benchmark.ts --noise 0 --budget 10 --seeds 3 --output results/p1_benchmark",
    "p1:benchmark:noisy": "tsx src/p1/p1Benchmark.ts --noise 0.05 --budget 10 --seeds 3 --output results/p1_noisy",
    "p1:benchmark:multi-noise": "tsx src/p1/p1Benchmark.ts --noise 0,0.01,0.05,0.1 --budget 10 --seeds 3 --output results/p1_multi_noise",
    "p2:benchmark": "tsx src/p2/p2Benchmark.ts --noise 0,0.01,0.05 --budget 10 --seeds 3 --output results/p2_physics_constrained",
    "p3:benchmark": "tsx src/p3/p3Benchmark.ts --noise 0,0.01,0.05 --budget 10 --seeds 3 --output results/p3_anomaly_refinement",
    "p4:benchmark": "tsx src/p4/p4Benchmark.ts --noise 0,0.01,0.05 --budget 10 --seeds 3 --output results/p4_open_ended_search",
    "p5:benchmark": "tsx src/p5/p5Benchmark.ts --noise 0,0.01,0.05 --budget 10 --seeds 3 --output results/p5_causal_mechanism",
    "reproduce:core": "bash scripts/reproduce_core.sh",
    "audit:claims": "bash scripts/audit_claims.sh",
    "audit:artifacts": "bash scripts/audit_artifacts.sh",
    "benchmark:all": "tsx src/core/runner.ts --benchmark all",
    "benchmark:p1": "tsx src/core/runner.ts --benchmark p1",
    "benchmark:p2": "tsx src/core/runner.ts --benchmark p2",
    "benchmark:p3": "tsx src/core/runner.ts --benchmark p3",
    "benchmark:p4": "tsx src/core/runner.ts --benchmark p4"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
