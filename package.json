{
  "name": "p0-vs",
  "version": "0.1.0",
  "type": "module",
  "description": "P0 rule-induction benchmark for Active Theory Discovery: active querying, version-space reasoning, and falsifiable hypothesis search.",
  "scripts": {
    "p0:gen": "tsx src/taskGenerator.ts --n 100 --seed 42 --output results/tasks_seed42.json",
    "p0:benchmark": "tsx src/runBenchmark.ts --n 100 --seed 42 --result-dir results",
    "p0:analyze": "tsx src/analyzeResults.ts --dir results --tasks results/tasks_seed42.json",
    "gen-tasks": "tsx src/taskGenerator.ts --n 100 --seed 42 --output results/tasks_seed42.json",
    "run-passive": "tsx src/runPassive.ts --tasks results/tasks_seed42.json --experiment-id p0_benchmark --condition passive --overwrite",
    "run-scaffold": "tsx src/runScaffold.ts --tasks results/tasks_seed42.json --experiment-id p0_benchmark --condition scaffold --overwrite",
    "run-active": "tsx src/runActive.ts --tasks results/tasks_seed42.json --experiment-id p0_benchmark --condition active --overwrite",
    "run-active-random": "tsx src/runActiveRandom.ts --tasks results/tasks_seed42.json --experiment-id p0_benchmark --condition active_random --overwrite",
    "analyze": "tsx src/analyzeResults.ts --dir results --tasks results/tasks_seed42.json",
    "benchmark": "tsx src/runBenchmark.ts --n 100 --seed 42 --result-dir results",
    "benchmark-no-llm": "tsx src/runBenchmark.ts --n 100 --seed 42 --result-dir results --skip-llm",
    "p1:benchmark": "tsx src/p1/p1Benchmark.ts --n 60 --seed 42 --noise 0 --output results/p1/p1_report.json",
    "p1:benchmark:noisy": "tsx src/p1/p1Benchmark.ts --n 60 --seed 42 --noise 0.05 --output results/p1/p1_report_noisy.json",
    "p1:test": "tsx src/p1/test.ts",
    "p1-benchmark": "tsx src/p1/p1Benchmark.ts --n 60 --seed 42 --noise 0 --output results/p1_report.json",
    "p1-benchmark-noisy": "tsx src/p1/p1Benchmark.ts --n 60 --seed 42 --noise 0.05 --output results/p1_report_noisy.json",
    "test": "tsx src/test.ts && tsx src/testApiSafety.ts && tsx src/testParseResponse.ts && tsx src/testRunnerMock.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
